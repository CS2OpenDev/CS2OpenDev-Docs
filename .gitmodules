[submodule "schema-tracker"]
	path = upstream/schema-tracker
	url = https://github.com/CS2OpenDev/CS2OpenDev-SchemaTracker.git
	# The generator only needs the single latest committed build's artifacts.
	# CI (and local setup) materialise this submodule with a partial clone
	# (--filter=blob:none) + cone sparse-checkout of just artifacts/<latest>,
	# so the multi-GB history/other builds are never fetched.  A plain
	# `git submodule update --init` still works but pulls everything.
	shallow = true
