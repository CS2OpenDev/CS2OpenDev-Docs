<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/gallery_dialog.css" />
	</styles>

	<Panel class="Root" hittest="false">
		<Panel id="dialog" class="Dismissed">
			<Label id="dialog_title" class="Title" text="Welcome, {s:name}" />
			<Label class="Body" text="Capture the point before the timer runs out. Type !menu in chat to pick a loadout." />
			<Button id="dismiss_button">
				<Label text="Got it" />
			</Button>
		</Panel>
	</Panel>
</root>
