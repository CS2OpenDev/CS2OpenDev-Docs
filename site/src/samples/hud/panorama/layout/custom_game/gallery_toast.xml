<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/gallery_toast.css" />
	</styles>

	<Panel class="Root" hittest="false">
		<Panel id="toast" hittest="false">
			<Panel class="Accent" hittest="false" />
