---
import { loadMeta } from '../../lib/data/meta';
import { codegenArtifactHref } from '../../lib/urls';

const m = loadMeta();
---

<p class="cs2-provenance">
	CS2 build {m.build_id} · Steam date {m.steam_date} · platform {m.platform} · generated{' '}
	<code>{m.generated_utc}</code> ·{' '}
	<a href={codegenArtifactHref('cs2_schema.json')}>cs2_schema.json</a>
</p>
