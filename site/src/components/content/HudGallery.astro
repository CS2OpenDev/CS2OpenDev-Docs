---
import HudShot from './HudShot.astro';
import { HUD_SAMPLES } from '../../lib/hud-samples';
import { withBase } from '../../lib/urls';
import '../../styles/hud.css';
---

<ul class="cs2-hud-gallery">
	{
		HUD_SAMPLES.map((s) => (
			<li class="cs2-hud-card">
				<a href={withBase(`/scripting/hud/${s.slug}/`)}>
					<HudShot slug={s.slug} />
					<span class="cs2-hud-card-title">{s.title}</span>
				</a>
				<p>{s.summary}</p>
				<p class="cs2-hud-uses">
					{s.uses.map((u) => (
						<code>{u}</code>
					))}
				</p>
			</li>
		))
	}
</ul>
