---
import { hudScreenshot, hudSample } from '../../lib/hud-samples';

interface Props {
	slug: string;
}

const sample = hudSample(Astro.props.slug);
const shot = hudScreenshot(sample.slug);
---

{
	shot ? (
		<img class="cs2-hud-shot" src={shot.src} width={shot.width} height={shot.height} alt={`${sample.title} in game`} loading="lazy" />
	) : (
		<div class="cs2-hud-shot cs2-hud-shot-missing" role="img" aria-label={`No screenshot yet for ${sample.title}`}>
			<span>Screenshot needed</span>
		</div>
	)
}
