---
export interface Props {
	code: string;
	caption?: string;
}

const { code, caption } = Astro.props;
---

<figure class="mermaid-figure" data-pagefind-ignore>
	<pre class="mermaid" set:text={code}></pre>
	{caption && <figcaption class="mermaid-caption">{caption}</figcaption>}
</figure>

<script>
	type MermaidApi = (typeof import('mermaid'))['default'];

	const MIN_HEIGHT = 160;
	const MAX_HEIGHT = 640;
	const MIN_SCALE = 0.05;
	const MAX_SCALE = 20;
	const HINT_IDLE = 'Click to zoom and pan';
	const HINT_ACTIVE = 'Scroll or pinch to zoom / Drag or arrow keys to pan';
	const KEY_PAN = 40;
	const KEY_ZOOM = 1.3;
	const DIAGRAM_TYPES: Record<string, string> = {
		classDiagram: 'Class diagram',
		flowchart: 'Flowchart',
		graph: 'Flowchart',
		sequenceDiagram: 'Sequence diagram',
		stateDiagram: 'State diagram',
		erDiagram: 'Entity relationship diagram',
	};

	const sources = new WeakMap<HTMLElement, string>();
	const teardowns = new WeakMap<HTMLElement, () => void>();
	// A render is queued but data-processed isn't set until the queue drains, so the
	// observer and a details toggle can both queue the same node before either finishes.
	const queued = new WeakSet<HTMLElement>();

	let mermaidPromise: Promise<MermaidApi> | null = null;
	let themeWatched = false;
	let chain: Promise<void> = Promise.resolve();

	function themeName(): 'default' | 'dark' {
		return document.documentElement.dataset.theme === 'light' ? 'default' : 'dark';
	}

	function diagrams(): HTMLElement[] {
		return Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'));
	}

	function queue(task: () => Promise<void>): void {
		chain = chain.then(task, task).catch(() => {});
	}

	// initialize() must land in the same microtask as the module resolving, before the
	// window load listener mermaid registers can fire with startOnLoad still default true.
	// A rejected promise is cleared so a failed load stays retryable.
	function loadMermaid(): Promise<MermaidApi> {
		if (!mermaidPromise) {
			mermaidPromise = import('mermaid')
				.then((mod) => {
					mod.default.initialize({ startOnLoad: false, theme: themeName() });
					return mod.default;
				})
				.catch((error: unknown) => {
					mermaidPromise = null;
					throw error;
				});
		}
		return mermaidPromise;
	}

	function clamp(value: number, low: number, high: number): number {
		return Math.max(low, Math.min(high, value));
	}

	function stash(nodes: HTMLElement[]): void {
		for (const node of nodes) {
			if (!sources.has(node)) sources.set(node, node.textContent ?? '');
		}
	}

	// mermaid clears the element before rendering and does not put the text back on
	// failure, so every restore path reads from the stash rather than the DOM.
	function restore(node: HTMLElement): void {
		node.textContent = sources.get(node) ?? '';
	}

	function diagramLabel(pre: HTMLElement): string {
		const caption = pre.closest('.mermaid-figure')?.querySelector('.mermaid-caption')?.textContent?.trim();
		if (caption) return caption;
		const head = (sources.get(pre) ?? '').trimStart().split(/[\s-]/, 1)[0] ?? '';
		return DIAGRAM_TYPES[head] ?? 'Diagram';
	}

	function reset(node: HTMLElement): void {
		const teardown = teardowns.get(node);
		if (teardown) {
			teardown();
			teardowns.delete(node);
		}
		const wrapper = node.parentElement;
		if (wrapper && wrapper.classList.contains('mermaid-zoom-wrapper')) {
			wrapper.parentNode?.insertBefore(node, wrapper);
			wrapper.remove();
		}
		node.closest('.mermaid-figure')?.querySelector('.mermaid-error')?.remove();
		node.removeAttribute('data-processed');
		node.removeAttribute('style');
		delete node.dataset.panzoom;
		restore(node);
	}

	function flagError(node: HTMLElement): void {
		restore(node);
		if (node.closest('.mermaid-figure')?.querySelector('.mermaid-error')) return;
		const note = document.createElement('div');
		note.className = 'mermaid-error';
		note.setAttribute('role', 'note');
		note.textContent = 'This diagram could not be rendered. Its source is shown above.';
		node.after(note);
	}

	function attach(pre: HTMLElement): void {
		if (pre.dataset.panzoom === '1') return;
		const svg = pre.querySelector('svg');
		if (!svg || !pre.parentNode) return;
		pre.dataset.panzoom = '1';

		const wrapper = document.createElement('div');
		wrapper.className = 'mermaid-zoom-wrapper';
		wrapper.tabIndex = 0;
		wrapper.setAttribute('role', 'group');
		wrapper.setAttribute('aria-label', diagramLabel(pre) + '. Activate to zoom and pan.');
		pre.parentNode.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);

		const controls = document.createElement('div');
		controls.className = 'mermaid-zoom-controls';
		controls.addEventListener('pointerdown', (event) => event.stopPropagation());
		controls.addEventListener('click', (event) => event.stopPropagation());
		const specs: Array<[string, string]> = [
			['+', 'Zoom in'],
			['−', 'Zoom out'],
			['↺', 'Reset view'],
		];
		const buttons = specs.map(([label, title]) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.textContent = label;
			button.title = title;
			button.setAttribute('aria-label', title);
			controls.appendChild(button);
			return button;
		});
		wrapper.appendChild(controls);

		const hint = document.createElement('div');
		hint.className = 'mermaid-zoom-hint';
		hint.textContent = HINT_IDLE;
		wrapper.appendChild(hint);

		const box = svg.viewBox && svg.viewBox.baseVal;
		const naturalW = (box && box.width) || parseFloat(svg.getAttribute('width') || '') || 800;
		const naturalH = (box && box.height) || parseFloat(svg.getAttribute('height') || '') || 440;

		// The pre is taken out of flow below, so the wrapper has no intrinsic height.
		// It has to carry one before the first fit or the fit divides by zero.
		wrapper.style.height = Math.round(clamp(naturalH, MIN_HEIGHT, MAX_HEIGHT)) + 'px';

		svg.removeAttribute('width');
		svg.removeAttribute('height');
		svg.style.position = 'absolute';
		svg.style.top = '0';
		svg.style.left = '0';
		svg.style.width = naturalW + 'px';
		svg.style.height = naturalH + 'px';
		svg.style.transformOrigin = '0 0';
		svg.style.maxWidth = 'none';
		svg.style.zIndex = '0';

		let scale = 1;
		let panX = 0;
		let panY = 0;

		// An arrow assigned after the null guard, so the narrowed svg stays non-null here.
		const applyTransform = (): void => {
			svg.style.transform = 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
		};

		function fitAndCenter(): void {
			const wr = wrapper.clientWidth || naturalW;
			const wh = wrapper.clientHeight || naturalH;
			scale = clamp(Math.min(wr / naturalW, wh / naturalH) * 0.95, MIN_SCALE, MAX_SCALE);
			panX = (wr - naturalW * scale) / 2;
			panY = (wh - naturalH * scale) / 2;
			applyTransform();
		}

		function zoomAt(x: number, y: number, factor: number): void {
			const next = clamp(scale * factor, MIN_SCALE, MAX_SCALE);
			panX = x - (x - panX) * (next / scale);
			panY = y - (y - panY) * (next / scale);
			scale = next;
			applyTransform();
		}

		function zoomAroundCenter(factor: number): void {
			zoomAt(wrapper.clientWidth / 2, wrapper.clientHeight / 2, factor);
		}

		let active = false;
		let dragging = false;
		let lastX = 0;
		let lastY = 0;
		// Every captured pointer; two of them is a pinch and lastX/lastY track the midpoint.
		const pointers = new Map<number, { x: number; y: number }>();
		let pinchDist = 0;

		function pinch(): { dist: number; midX: number; midY: number } | null {
			const pts = [...pointers.values()];
			const a = pts[0];
			const b = pts[1];
			if (!a || !b) return null;
			return { dist: Math.hypot(b.x - a.x, b.y - a.y), midX: (a.x + b.x) / 2, midY: (a.y + b.y) / 2 };
		}

		function onWheel(event: WheelEvent): void {
			event.preventDefault();
			const rect = wrapper.getBoundingClientRect();
			zoomAt(event.clientX - rect.left, event.clientY - rect.top, event.deltaY < 0 ? 1.15 : 1 / 1.15);
		}

		function onOutside(event: PointerEvent): void {
			if (!wrapper.contains(event.target as Node)) deactivate();
		}

		function onKey(event: KeyboardEvent): void {
			if (event.key === 'Escape') deactivate();
		}

		function activate(): void {
			if (active) return;
			active = true;
			wrapper.classList.add('is-active');
			hint.textContent = HINT_ACTIVE;
			// passive:false only while active, so an inactive diagram never blocks page scroll.
			wrapper.addEventListener('wheel', onWheel, { passive: false });
			document.addEventListener('pointerdown', onOutside, true);
			document.addEventListener('keydown', onKey);
			wrapper.focus({ preventScroll: true });
		}

		function deactivate(): void {
			if (!active) return;
			active = false;
			dragging = false;
			pointers.clear();
			wrapper.classList.remove('is-active', 'is-dragging');
			hint.textContent = HINT_IDLE;
			wrapper.removeEventListener('wheel', onWheel);
			document.removeEventListener('pointerdown', onOutside, true);
			document.removeEventListener('keydown', onKey);
			if (document.activeElement === wrapper) wrapper.blur();
		}

		wrapper.addEventListener('click', activate);
		wrapper.addEventListener('keydown', (event) => {
			if (!active) {
				// Only the wrapper itself activates; a focused zoom button keeps its own Enter.
				if (event.target === wrapper && (event.key === 'Enter' || event.key === ' ')) {
					event.preventDefault();
					activate();
				}
				return;
			}
			switch (event.key) {
				case 'ArrowLeft':
					panX += KEY_PAN;
					break;
				case 'ArrowRight':
					panX -= KEY_PAN;
					break;
				case 'ArrowUp':
					panY += KEY_PAN;
					break;
				case 'ArrowDown':
					panY -= KEY_PAN;
					break;
				case '+':
				case '=':
					zoomAroundCenter(KEY_ZOOM);
					break;
				case '-':
				case '_':
					zoomAroundCenter(1 / KEY_ZOOM);
					break;
				case '0':
					fitAndCenter();
					break;
				default:
					return;
			}
			event.preventDefault();
			applyTransform();
		});

		wrapper.addEventListener('pointerdown', (event) => {
			if (!active) return;
			pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
			try {
				wrapper.setPointerCapture(event.pointerId);
			} catch {}
			const p = pinch();
			if (p) {
				dragging = false;
				pinchDist = p.dist;
				lastX = p.midX;
				lastY = p.midY;
				return;
			}
			dragging = true;
			lastX = event.clientX;
			lastY = event.clientY;
			wrapper.classList.add('is-dragging');
		});
		wrapper.addEventListener('pointermove', (event) => {
			const tracked = pointers.get(event.pointerId);
			if (tracked) {
				tracked.x = event.clientX;
				tracked.y = event.clientY;
			}
			const p = tracked && pinch();
			if (p) {
				const rect = wrapper.getBoundingClientRect();
				panX += p.midX - lastX;
				panY += p.midY - lastY;
				if (pinchDist > 0 && p.dist > 0) zoomAt(p.midX - rect.left, p.midY - rect.top, p.dist / pinchDist);
				else applyTransform();
				pinchDist = p.dist;
				lastX = p.midX;
				lastY = p.midY;
				return;
			}
			if (!dragging) return;
			panX += event.clientX - lastX;
			panY += event.clientY - lastY;
			lastX = event.clientX;
			lastY = event.clientY;
			applyTransform();
		});
		function endDrag(event: PointerEvent): void {
			pointers.delete(event.pointerId);
			const p = pinch();
			if (p) {
				pinchDist = p.dist;
				lastX = p.midX;
				lastY = p.midY;
				return;
			}
			const rest = [...pointers.values()][0];
			if (rest) {
				// One finger left after a pinch: carry on as a drag from where it is.
				dragging = true;
				lastX = rest.x;
				lastY = rest.y;
				wrapper.classList.add('is-dragging');
				return;
			}
			dragging = false;
			wrapper.classList.remove('is-dragging');
		}
		wrapper.addEventListener('pointerup', endDrag);
		wrapper.addEventListener('pointercancel', endDrag);

		buttons[0]?.addEventListener('click', () => zoomAroundCenter(1.3));
		buttons[1]?.addEventListener('click', () => zoomAroundCenter(1 / 1.3));
		buttons[2]?.addEventListener('click', fitAndCenter);

		let fitted = false;
		function initialFit(): void {
			if (fitted || wrapper.clientWidth === 0 || wrapper.clientHeight === 0) return;
			fitted = true;
			fitAndCenter();
			resize?.disconnect();
		}
		const resize = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(initialFit);
		resize?.observe(wrapper);
		requestAnimationFrame(initialFit);

		teardowns.set(pre, () => {
			deactivate();
			resize?.disconnect();
		});
	}

	async function render(nodes: HTMLElement[]): Promise<void> {
		if (nodes.length === 0) return;
		const mermaid = await loadMermaid();
		mermaid.initialize({
			startOnLoad: false,
			securityLevel: 'strict',
			// Without this mermaid replaces a failed diagram with its own error graphic,
			// which would pass the "has an svg" check below.
			suppressErrorRendering: true,
			theme: themeName(),
		});
		await mermaid.run({ nodes, suppressErrors: true });
		for (const node of nodes) {
			if (node.querySelector('svg')) attach(node);
			else flagError(node);
		}
	}

	function watchTheme(): void {
		if (themeWatched) return;
		themeWatched = true;
		let last = document.documentElement.dataset.theme;
		const observer = new MutationObserver(() => {
			const next = document.documentElement.dataset.theme;
			if (next === last) return;
			last = next;
			if (!mermaidPromise) return;
			// The reset has to be queued too. Tearing down mid render would leave mermaid
			// writing its svg over the restored source.
			queue(async () => {
				const nodes = diagrams();
				for (const node of nodes) reset(node);
				await render(nodes);
			});
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	}

	function renderOne(node: HTMLElement): void {
		if (node.hasAttribute('data-processed') || queued.has(node)) return;
		queued.add(node);
		queue(async () => {
			await render([node]);
			queued.delete(node);
		});
	}

	function boot(): void {
		const nodes = diagrams();
		if (nodes.length === 0) return;
		stash(nodes);
		watchTheme();
		const pending = nodes.filter((node) => !node.hasAttribute('data-processed'));
		if (pending.length === 0) return;
		if (typeof IntersectionObserver === 'undefined') {
			queue(() => render(pending));
			return;
		}
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.unobserve(entry.target);
					renderOne(entry.target as HTMLElement);
				}
			},
			{ rootMargin: '400px 0px' }
		);

		for (const node of pending) {
			const details = node.closest('details');
			// A closed <details> hides its content at zero size, and opening it does not
			// reliably re-fire the observer in every browser. Render straight off the
			// toggle in that case rather than waiting on the observer to notice; the
			// observer only has to catch what already has real geometry to intersect.
			if (details) {
				details.addEventListener('toggle', () => {
					if (details.open) renderOne(node);
				});
			}
			if (!details || details.open) observer.observe(node);
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot, { once: true });
	} else {
		boot();
	}
	document.addEventListener('astro:page-load', boot);
</script>

