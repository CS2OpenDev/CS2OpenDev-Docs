---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DataTable, { PAGE_SIZE, type Column } from '../../components/islands/DataTable';
import TableRowsNote from '../../components/TableRowsNote.astro';
import { provenanceLine } from '../../lib/provenance';
import { loadMusicKits, musicKitRows } from '../../lib/data/items';
import { itemsHref, withBase } from '../../lib/urls';

const kits = loadMusicKits();

const columns: Column[] = [
	{ key: 'def_index', label: 'Def index', numeric: true },
	{ key: 'name', label: 'Name', mono: true },
	{ key: 'loc_name', label: 'Loc name' },
];

// Only the first page rides in the island's props; anything past it comes from
// music-kits/rows.json.ts on first interaction.
const rows = musicKitRows().slice(0, PAGE_SIZE);
const rowsHref = withBase('/items/music-kits/rows.json');
---

<StarlightPage
	frontmatter={{
		title: 'Music Kits',
		description: `${kits.length} music kit definitions for this build.`,
	}}
>
	<div data-pagefind-body>
		<p>
			Music kit definitions: every music kit this build's economy tables carry, keyed by{' '}
			<code>def_index</code>. Back to <a href={itemsHref()}>Items</a>.
		</p>

		<p class="cs2-provenance">{provenanceLine()}</p>

		<DataTable
			id="mk"
			columns={columns}
			rows={rows}
			src={rowsHref}
			anchorKey="name"
			caption="Music kits"
			pageSize={PAGE_SIZE}
			initialSort={{ key: 'def_index', dir: 'asc' }}
			client:idle
		/>
		<TableRowsNote shown={rows.length} total={kits.length} rowsHref={rowsHref} />
	</div>
</StarlightPage>
