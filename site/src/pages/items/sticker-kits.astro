---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DataTable, { PAGE_SIZE, type Column } from '../../components/islands/DataTable';
import TableRowsNote from '../../components/TableRowsNote.astro';
import { provenanceLine } from '../../lib/provenance';
import { loadStickerKits, stickerKitRows } from '../../lib/data/items';
import { itemsHref, withBase } from '../../lib/urls';

const allKits = loadStickerKits();

const columns: Column[] = [
	{ key: 'def_index', label: 'Def index', numeric: true },
	{ key: 'name', label: 'Name', mono: true },
	{ key: 'item_name_token', label: 'Name token' },
	{ key: 'description', label: 'Description token' },
];

// Astro serializes the whole `rows` prop regardless of pageSize; at 11,789 rows
// that alone put this page over the 3 MB budget. Only the first page rides in
// the props; the rest comes from rows.json.ts on first interaction.
const rows = stickerKitRows().slice(0, PAGE_SIZE);
const rowsHref = withBase('/items/sticker-kits/rows.json');
---

<StarlightPage
	frontmatter={{
		title: 'Sticker Kits',
		description: `${allKits.length} sticker kit definitions for this build.`,
	}}
>
	<div>
	<div data-pagefind-ignore>
		<p>
			Sticker definitions: every sticker kit this build's economy tables carry, keyed by{' '}
			<code>def_index</code>. Back to <a href={itemsHref()}>Items</a>.
		</p>

		<p class="cs2-provenance">{provenanceLine()}</p>

		<DataTable
			id="sk"
			columns={columns}
			rows={rows}
			src={rowsHref}
			anchorKey="name"
			caption="Sticker kits"
			pageSize={PAGE_SIZE}
			initialSort={{ key: 'def_index', dir: 'asc' }}
			client:idle
		/>
		<TableRowsNote shown={rows.length} total={allKits.length} rowsHref={rowsHref} />
	</div>
	</div>
</StarlightPage>
