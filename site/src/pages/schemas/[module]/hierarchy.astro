---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import HierarchyTree from '../../../components/hierarchy/HierarchyTree.astro';
import { forestInheritanceDiagram } from '../../../components/hierarchy/diagram';
import { sortRootsBySize } from '../../../components/hierarchy/forest';
import { hierarchyHref, moduleHref, schemasHref } from '../../../lib/urls';
import { loadSchemaIndex, type ClassEntity } from '../../../lib/data/schema';
import { buildModuleForest } from '../../../lib/tree';

export function getStaticPaths() {
	const idx = loadSchemaIndex();
	return idx.modules.map((module) => ({ params: { module } }));
}

/** Modules at or under this size get the diagram open by default; past it, it starts collapsed. */
const DIAGRAM_CLASS_CAP = 40;
/** Same cap the old Jekyll site used for its per-module UML page. */
const DIAGRAM_EDGE_CAP = 300;

const { module } = Astro.params;
const idx = loadSchemaIndex();
const p = idx.provenance;

const classes = (idx.byModule.get(module!) ?? []).filter((e): e is ClassEntity => e.kind === 'class');
const roots = sortRootsBySize(buildModuleForest(idx, module!));
const diagram = forestInheritanceDiagram(roots, DIAGRAM_EDGE_CAP);
const diagramOpen = classes.length <= DIAGRAM_CLASS_CAP;

const headings = [{ depth: 2, slug: 'tree', text: 'Inheritance tree' }];
---

<StarlightPage
	frontmatter={{
		title: `${module} hierarchy`,
		description: `Inheritance tree for the ${classes.length} classes in the CS2 ${module} module, build ${p.buildId}.`,
	}}
	headings={headings}
>
	<div>
		<nav class="cs2-breadcrumb" aria-label="Breadcrumb">
			<a href={schemasHref()}>Schemas</a> / <a href={moduleHref(module!)}>{module}</a> / <span>Hierarchy</span>
		</nav>

		{(module === 'server' || module === 'client') && (
			<p class="cs2-note">
				This tree covers only <code>{module}</code>. See the{' '}
				<a href={hierarchyHref()}>combined server and client tree</a> for the twinned classes
				the two projects share by name.
			</p>
		)}

		<h2 id="tree">Inheritance tree</h2>
		<HierarchyTree
			nodes={roots}
			countLine={`${classes.length} classes, ${roots.length} root hierarchies.`}
			homeModule={module}
			diagram={diagram}
			diagramOpen={diagramOpen}
		/>
	</div>
</StarlightPage>
