---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DataTable, { type Column, type Row } from '../components/islands/DataTable';
import { provenanceLine } from '../lib/provenance';
import { escapeHtml } from '../lib/html';
import { protoMessageHref } from '../lib/urls';
import { loadProtoIndex, schemaEnumHref } from '../lib/data/protobufs';
import { identifierAliases, loadSchemaIndex } from '../lib/data/schema';
import {
	eventHeading,
	loadGameEventsData,
	sourceStem,
	typeLegendAnchor,
	type GameEvent,
} from '../lib/data/gameevents';
import '../styles/console.css';

const { events, duplicates, sources, type_legend: typeLegend } = loadGameEventsData();
const protoIdx = loadProtoIndex();
const schemaIdx = loadSchemaIndex();

const eventMsg = protoIdx.messageByQualified.get('CMsgSource1LegacyGameEvent');
const listMsg = protoIdx.messageByQualified.get('CMsgSource1LegacyGameEventList');
const keyTMsg = protoIdx.messageByQualified.get('CMsgSource1LegacyGameEvent.key_t');

function wireIdText(hit: typeof eventMsg) {
	const w = hit?.message.wire_ids[0];
	if (!hit || !w) return null;
	const enumHref = schemaEnumHref(schemaIdx, w.enum);
	return { enumName: w.enum, constant: w.constant, value: w.value, href: enumHref };
}
const eventWire = wireIdText(eventMsg);
const listWire = wireIdText(listMsg);

const duplicateCount = Object.keys(duplicates).length;

function eventAliases(ev: GameEvent): string {
	return [...identifierAliases(ev.name), ...ev.fields.map((f) => f.name)].join(' ');
}

const columns: Column[] = [
	{ key: 'name', label: 'Name', html: true },
	{ key: 'source', label: 'Source' },
	{ key: 'fields', label: 'Fields', numeric: true },
	{ key: 'description', label: 'Description' },
];

const rows: Row[] = events.map((ev) => ({
	name: `<a href="#${ev.anchor}">${escapeHtml(eventHeading(ev, duplicates))}</a>`,
	source: sourceStem(ev.source),
	fields: ev.fields.length,
	description: ev.description,
	// Text-only shadow field: the Name column's value is markup, so search matches on
	// href/tag noise unless it reads this plain field instead.
	search: `${ev.name} ${ev.source} ${ev.description}`.trim(),
}));

const headings = [
	{ depth: 2, slug: 'type-legend', text: 'Field types' },
	{ depth: 2, slug: 'sources', text: 'Sources' },
	{ depth: 2, slug: 'index', text: 'Index' },
	{ depth: 2, slug: 'events', text: 'Events' },
	...events.map((ev) => ({ depth: 3, slug: ev.anchor, text: eventHeading(ev, duplicates) })),
];
---

<StarlightPage
	frontmatter={{
		title: 'Game Events',
		description: `${events.length} game event definitions for this build, with field types and per-event field tables.`,
	}}
	headings={headings}
>
	<div data-pagefind-body>
		<p>
			A game event is a named, one-shot notification the server broadcasts to clients and writes into a{' '}
			<code>.dem</code> recording — a round starting, a player dying, a bomb being planted. Every event
			travels as one instance of the same protobuf message,{' '}
			{eventMsg ? (
				<a href={protoMessageHref(eventMsg.file.stem, eventMsg.message.qualified)}>
					{eventMsg.message.qualified}
				</a>
			) : (
				<code>CMsgSource1LegacyGameEvent</code>
			)}
			{eventWire && (
				<>
					{' '}
					(wire id{' '}
					{eventWire.href ? (
						<a href={eventWire.href}>{eventWire.enumName}.{eventWire.constant}</a>
					) : (
						<>{eventWire.enumName}.{eventWire.constant}</>
					)}
					{' = '}<code>{eventWire.value}</code>)
				</>
			)}
			, whose <code>event_name</code> and <code>eventid</code> fields say which definition below applies
			and whose repeated <code>keys</code> field carries the event's own fields as typed key/value pairs (
			{keyTMsg ? (
				<a href={protoMessageHref(keyTMsg.file.stem, keyTMsg.message.qualified)}>{keyTMsg.message.qualified}</a>
			) : (
				<code>CMsgSource1LegacyGameEvent.key_t</code>
			)}
			, one union entry per key). Before any event fires, the server sends the whole registry once as{' '}
			{listMsg ? (
				<a href={protoMessageHref(listMsg.file.stem, listMsg.message.qualified)}>{listMsg.message.qualified}</a>
			) : (
				<code>CMsgSource1LegacyGameEventList</code>
			)}
			{listWire && (
				<>
					{' '}
					(wire id{' '}
					{listWire.href ? (
						<a href={listWire.href}>{listWire.enumName}.{listWire.constant}</a>
					) : (
						<>{listWire.enumName}.{listWire.constant}</>
					)}
					{' = '}<code>{listWire.value}</code>)
				</>
			)}
			, which is how a client or a demo parser learns which numeric <code>eventid</code> maps to which of
			the {events.length} definitions below and what each key's declared type is.
		</p>

		<p class="cs2-provenance">{provenanceLine()}</p>

		<h2 id="type-legend">Field types</h2>
		<p>
			Each field below declares one of these types. Where the type is sent as one of{' '}
			{keyTMsg ? (
				<a href={protoMessageHref(keyTMsg.file.stem, keyTMsg.message.qualified)}>key_t</a>
			) : (
				<code>key_t</code>
			)}'s union members, its numeric wire code is the member's own field number minus one (
			<code>val_string</code> is field 2, so type code 1; <code>val_uint64</code> is field 8, so type code
			7). <code>player_controller_and_pawn</code> is not one of the union members: it packs two indices
			into one plain integer sent as type code 3, decoded as{' '}
			<code>controller_id = value &amp; 0xFF</code>, <code>pawn_index = value &gt;&gt; 8</code>.
		</p>
		<div class="cs2-table-wrap cs2-legend-table">
			<table>
				<thead>
					<tr>
						<th>Type</th>
						<th class="value">key_t code</th>
						<th class="ann">Description</th>
						<th class="ann">Note</th>
					</tr>
				</thead>
				<tbody>
					{typeLegend.map((t) => (
						<tr id={typeLegendAnchor(t.type)}>
							<td><code>{t.type}</code></td>
							<td class="value">{t.key_t_type_code === null ? '—' : t.key_t_type_code}</td>
							<td class="ann">{t.description}</td>
							<td class="ann">{t.note}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<h2 id="sources">Sources</h2>
		<p>
			Events come from {sources.length} upstream <code>.gameevents</code> files:{' '}
			{sources.map((s, i) => (
				<>{i > 0 && ', '}<code>{s}</code></>
			))}
			. {duplicateCount} event names are declared in more than one source (<code>round_end</code> is in
			all three); each declaration keeps its own anchor built from the name plus its source stem, e.g.{' '}
			<code>player_death-core</code> (the 2-field base engine stub) versus <code>player_death-mod</code>{' '}
			(the 22-field definition this game mode actually fires), so every declaration below is reachable on
			its own section instead of colliding on one shared anchor.
		</p>

		<h2 id="index">Index</h2>
		<p>Every event definition in this build. Type a name, source or description word into the filter box.</p>
		<div id="ev">
			<DataTable
				id="ev"
				columns={columns}
				rows={rows}
				searchKeys={['search']}
				pageSize={0}
				caption={`${events.length} game event definitions`}
				initialSort={{ key: 'name', dir: 'asc' }}
				client:idle
			/>
		</div>

		<h2 id="events">Events</h2>
		{events.map((ev) => (
			<>
				<h3 id={ev.anchor} data-pagefind-weight="7">{eventHeading(ev, duplicates)}</h3>
				<span class="cs2-aliases">{eventAliases(ev)}</span>
				{ev.description && <p>{ev.description}</p>}
				{ev.notes && <p class="cs2-note">{ev.notes}</p>}
				{ev.warning && (
					<p class="cs2-note">
						<strong>Warning:</strong> {ev.warning}
					</p>
				)}
				<p class="cs2-rel">
					<strong>Source:</strong> <code>{ev.source}</code>
					{' · '}
					<strong>Fields:</strong> {ev.fields.length}
				</p>
				{ev.fields.length === 0 ? (
					<p class="cs2-empty">This event carries no fields.</p>
				) : (
					<div class="cs2-table-wrap">
						<table>
							<thead>
								<tr>
									<th>Field</th>
									<th>Type</th>
									<th class="ann">Description</th>
								</tr>
							</thead>
							<tbody>
								{ev.fields.map((f) => (
									<tr>
										<td><code>{f.name}</code></td>
										<td><code>{f.type}</code></td>
										<td class="ann">{f.description}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}
			</>
		))}
	</div>
</StarlightPage>
